entry:
  %cold = icmp eq i32 %n, 0
  br i1 %cold, label %slow, label %fast, !prof !0

slow:
  %m = mul nsw i32 %x, %y
  %mf = sitofp i32 %m to float
  %c = tail call float @ext_f(float %mf)
  ret float %c

fast:
  %p = fmul float %a, %b
  ret float %p
}

!0 = !{!"branch_weights", i32 1, i32 2000}
