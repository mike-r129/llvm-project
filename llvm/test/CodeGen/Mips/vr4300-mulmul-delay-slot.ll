; SEARCH-NEXT:    mflo $1
; SEARCH-NEXT:    mtc1 $1, $f12
; SEARCH-NEXT:    nop
; SEARCH-NEXT:    jal ext_f
; SEARCH-NEXT:    cvt.s.w $f12, $f12
; SEARCH-NEXT:    ld $ra, 8($sp) # 8-byte Folded Reload
