# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mips64 -mcpu=mips3 -target-abi=n32 \
# RUN:   -run-pass=mips-vr4300-mulmul-fix -verify-machineinstrs -o - %s \
# RUN:   | FileCheck %s

# Every FPU multiply is followed by a nop, whatever comes next: the integer
# multiplies are still pseudos when the pass runs, and the next instruction
# executed can be in the next block or, after a return, in the caller.

---
name:            mul_s_mult
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $f12, $f13, $a2, $a3
    ; CHECK-LABEL: name: mul_s_mult
    ; CHECK: liveins: $f12, $f13, $a2, $a3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $f0 = nofpexcept FMUL_S killed renamable $f12, killed renamable $f13, implicit $fcr31
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: renamable $ac0 = PseudoMULT killed renamable $a2, killed renamable $a3
    ; CHECK-NEXT: $v0 = MFLO implicit $ac0
    ; CHECK-NEXT: PseudoReturn64 undef $ra_64, implicit $v0, implicit $f0
    renamable $f0 = nofpexcept FMUL_S killed renamable $f12, killed renamable $f13, implicit $fcr31
    renamable $ac0 = PseudoMULT killed renamable $a2, killed renamable $a3
    $v0 = MFLO implicit $ac0
    PseudoReturn64 undef $ra_64, implicit $v0, implicit $f0
...
---
