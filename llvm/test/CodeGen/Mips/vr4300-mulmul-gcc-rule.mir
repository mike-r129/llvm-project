---
# The multiply is the last instruction of a block that falls through into a
# block that starts with a multiply.
name:            fallthrough
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: fallthrough
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $a0, $f12, $f13, $f14
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BEQ killed renamable $a0, $zero, %bb.2, implicit-def $at
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $f12, $f13, $f14
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $f12 = nofpexcept FMUL_S killed renamable $f12, killed renamable $f13, implicit $fcr31
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $f12, $f14
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $f0 = nofpexcept FMUL_S killed renamable $f12, killed renamable $f14, implicit $fcr31
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   PseudoReturn64 undef $ra_64, implicit $f0
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $a0, $f12, $f13, $f14

    BEQ killed renamable $a0, $zero, %bb.2, implicit-def $at

  bb.1:
    successors: %bb.2
    liveins: $f12, $f13, $f14

    renamable $f12 = nofpexcept FMUL_S killed renamable $f12, killed renamable $f13, implicit $fcr31

  bb.2:
    liveins: $f12, $f14

    renamable $f0 = nofpexcept FMUL_S killed renamable $f12, killed renamable $f14, implicit $fcr31
    PseudoReturn64 undef $ra_64, implicit $f0
...
---
# The multiply is followed by a return: the caller may multiply next.
name:            before_return
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $f12
    ; CHECK-LABEL: name: before_return
    ; CHECK: liveins: $f12
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $f0 = nofpexcept FMUL_S killed renamable $f12, renamable $f12, implicit $fcr31
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: PseudoReturn64 undef $ra_64, implicit $f0
    renamable $f0 = nofpexcept FMUL_S killed renamable $f12, renamable $f12, implicit $fcr31
    PseudoReturn64 undef $ra_64, implicit $f0
...
---
# Not a multiply next, but the nop also keeps the delay slot filler from moving
# the multiply past it.
name:            mul_s_add
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $f12, $f13, $a0
    ; CHECK-LABEL: name: mul_s_add
    ; CHECK: liveins: $f12, $f13, $a0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $f0 = nofpexcept FMUL_S killed renamable $f12, killed renamable $f13, implicit $fcr31
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: renamable $v0 = ADDiu killed renamable $a0, 1
    ; CHECK-NEXT: PseudoReturn64 undef $ra_64, implicit $v0, implicit $f0
    renamable $f0 = nofpexcept FMUL_S killed renamable $f12, killed renamable $f13, implicit $fcr31
    renamable $v0 = ADDiu killed renamable $a0, 1
    PseudoReturn64 undef $ra_64, implicit $v0, implicit $f0
...
