    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: renamable $ac0 = PseudoMULTu killed renamable $a2, killed renamable $a3
    ; CHECK-NEXT: $v0 = MFLO implicit $ac0
    ; CHECK-NEXT: PseudoReturn64 undef $ra_64, implicit $v0, implicit $f0
    renamable $f0 = nofpexcept FMUL_S killed renamable $f12, killed renamable $f13, implicit $fcr31
    renamable $ac0 = PseudoMULTu killed renamable $a2, killed renamable $a3
    $v0 = MFLO implicit $ac0
    PseudoReturn64 undef $ra_64, implicit $v0, implicit $f0
...
