    PseudoReturn64 undef $ra_64, implicit $v0, implicit $v1, implicit $a3
...
---
# The mfhi starts its own window even though the mflo before it is still
# pending: one nop between the or and the dmult.
name:            mflo_mfhi_or_dmult
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $a0_64, $a1_64, $a2_64, $a3_64
    ; MIPS3-LABEL: name: mflo_mfhi_or_dmult
    ; MIPS3: liveins: $a0_64, $a1_64, $a2_64, $a3_64
