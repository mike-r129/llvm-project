    ; MIPS64-NEXT: MTLO killed $a2, implicit-def $lo0
    ; MIPS64-NEXT: PseudoReturn64 undef $ra_64, implicit $v0, implicit $v1
    renamable $ac0 = PseudoUDIV killed renamable $a0, renamable $a1
    $v1 = MFHI implicit $ac0
    $v0 = MFLO implicit $ac0
    MTLO killed $a2, implicit-def $lo0
    PseudoReturn64 undef $ra_64, implicit $v0, implicit $v1
...
