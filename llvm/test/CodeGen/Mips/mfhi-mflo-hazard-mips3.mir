# RUN:   -run-pass=mips-branch-expansion -verify-machineinstrs -o - %s \
# RUN:   | FileCheck %s --check-prefix=MIPS64

# On MIPS I-IV, the two instructions after an mfhi/mflo must not write HI/LO:
# mult, multu, div, divu, dmult, dmultu, ddiv, ddivu, mthi and mtlo.
# MIPS32/MIPS64 interlock HI/LO, so no nops are needed there.

---
name:            mfhi_dmultu
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $a0_64, $a1_64, $a3_64
    ; MIPS3-LABEL: name: mfhi_dmultu
    ; MIPS3: liveins: $a0_64, $a1_64, $a3_64
    ; MIPS3-NEXT: {{  $}}
    ; MIPS3-NEXT: renamable $ac0_64 = PseudoDMULTu killed renamable $a0_64, killed renamable $a1_64
    ; MIPS3-NEXT: $at_64 = MFHI64 implicit $ac0_64 {
    ; MIPS3-NEXT:   $zero = SLL $zero, 0
    ; MIPS3-NEXT:   $zero = SLL $zero, 0
    ; MIPS3-NEXT: }
    ; MIPS3-NEXT: renamable $ac0_64 = PseudoDMULTu killed renamable $at_64, killed renamable $a3_64
    ; MIPS3-NEXT: $v0_64 = MFLO64 implicit $ac0_64
    ; MIPS3-NEXT: PseudoReturn64 undef $ra_64, implicit $v0_64
    ;
    ; MIPS64-LABEL: name: mfhi_dmultu
    ; MIPS64: liveins: $a0_64, $a1_64, $a3_64
    ; MIPS64-NEXT: {{  $}}
    ; MIPS64-NEXT: renamable $ac0_64 = PseudoDMULTu killed renamable $a0_64, killed renamable $a1_64
    ; MIPS64-NEXT: $at_64 = MFHI64 implicit $ac0_64
    ; MIPS64-NEXT: renamable $ac0_64 = PseudoDMULTu killed renamable $at_64, killed renamable $a3_64
    ; MIPS64-NEXT: $v0_64 = MFLO64 implicit $ac0_64
    ; MIPS64-NEXT: PseudoReturn64 undef $ra_64, implicit $v0_64
    renamable $ac0_64 = PseudoDMULTu killed renamable $a0_64, killed renamable $a1_64
    $at_64 = MFHI64 implicit $ac0_64
    renamable $ac0_64 = PseudoDMULTu killed renamable $at_64, killed renamable $a3_64
    $v0_64 = MFLO64 implicit $ac0_64
    PseudoReturn64 undef $ra_64, implicit $v0_64
...
---
name:            mfhi_multu_gap1
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $a0, $a1, $a2
    ; MIPS3-LABEL: name: mfhi_multu_gap1
    ; MIPS3: liveins: $a0, $a1, $a2
    ; MIPS3-NEXT: {{  $}}
    ; MIPS3-NEXT: renamable $ac0 = PseudoMULT killed renamable $a0, renamable $a1
    ; MIPS3-NEXT: $v0 = MFHI implicit $ac0
    ; MIPS3-NEXT: $v1 = ADDiu killed $v0, 1 {
    ; MIPS3-NEXT:   $zero = SLL $zero, 0
    ; MIPS3-NEXT: }
    ; MIPS3-NEXT: renamable $ac0 = PseudoMULTu killed renamable $a1, killed renamable $a2
    ; MIPS3-NEXT: $v0 = MFLO implicit $ac0
    ; MIPS3-NEXT: PseudoReturn64 undef $ra_64, implicit $v0, implicit $v1
    ;
    ; MIPS64-LABEL: name: mfhi_multu_gap1
    ; MIPS64: liveins: $a0, $a1, $a2
    ; MIPS64-NEXT: {{  $}}
    ; MIPS64-NEXT: renamable $ac0 = PseudoMULT killed renamable $a0, renamable $a1
    ; MIPS64-NEXT: $v0 = MFHI implicit $ac0
    ; MIPS64-NEXT: $v1 = ADDiu killed $v0, 1
    ; MIPS64-NEXT: renamable $ac0 = PseudoMULTu killed renamable $a1, killed renamable $a2
    ; MIPS64-NEXT: $v0 = MFLO implicit $ac0
    ; MIPS64-NEXT: PseudoReturn64 undef $ra_64, implicit $v0, implicit $v1
    renamable $ac0 = PseudoMULT killed renamable $a0, renamable $a1
    $v0 = MFHI implicit $ac0
    $v1 = ADDiu killed $v0, 1
    renamable $ac0 = PseudoMULTu killed renamable $a1, killed renamable $a2
    $v0 = MFLO implicit $ac0
    PseudoReturn64 undef $ra_64, implicit $v0, implicit $v1
...
