    ; MIPS64-NEXT: MTHI killed $a2, implicit-def $hi0
    ; MIPS64-NEXT: PseudoReturn64 undef $ra_64, implicit $v0, implicit $v1, implicit $a3
    renamable $ac0 = PseudoMULT killed renamable $a0, renamable $a1
    $v0 = MFHI implicit $ac0
    $v1 = ADDiu $a1, 1
    $a3 = ADDiu killed $a1, 2
