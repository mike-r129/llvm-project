    ; MIPS3-NEXT: $at_64 = MFLO64 implicit $ac0_64
    ; MIPS3-NEXT: $v1_64 = MFHI64 implicit $ac0_64
    ; MIPS3-NEXT: $at_64 = OR64 killed $at_64, killed $a2_64 {
    ; MIPS3-NEXT:   $zero = SLL $zero, 0
    ; MIPS3-NEXT: }
    ; MIPS3-NEXT: renamable $ac0_64 = PseudoDMULT killed renamable $at_64, killed renamable $a3_64
    ; MIPS3-NEXT: $v0_64 = MFLO64 implicit $ac0_64
    ; MIPS3-NEXT: PseudoReturn64 undef $ra_64, implicit $v0_64, implicit $v1_64
    ;
    ; MIPS64-LABEL: name: mflo_mfhi_or_dmult
    ; MIPS64: liveins: $a0_64, $a1_64, $a2_64, $a3_64
    ; MIPS64-NEXT: {{  $}}
    ; MIPS64-NEXT: renamable $ac0_64 = PseudoDMULTu killed renamable $a0_64, renamable $a1_64
    ; MIPS64-NEXT: $at_64 = MFLO64 implicit $ac0_64
