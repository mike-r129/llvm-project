; On MIPS I-IV, the two instructions after an mfhi/mflo must not write HI/LO.
; That includes the unsigned multiplies (multu, dmultu), and the window of
; each read, also when two reads are back to back. MIPS32/MIPS64 interlock
; HI/LO.

; 128-bit multiply: an mflo followed by dmultu.
define i128 @mul128(i128 %a, i128 %b) {
; MIPS3-LABEL: mul128:
; MIPS3:       # %bb.0: # %entry
; MIPS3-NEXT:    dmult $4, $7
; MIPS3-NEXT:    mflo $1
; MIPS3-NEXT:    nop
; MIPS3-NEXT:    nop
; MIPS3-NEXT:    dmult $5, $6
; MIPS3-NEXT:    mflo $2
; MIPS3-NEXT:    nop
; MIPS3-NEXT:    nop
; MIPS3-NEXT:    dmultu $5, $7
; MIPS3-NEXT:    mflo $3
; MIPS3-NEXT:    mfhi $4
; MIPS3-NEXT:    daddu $2, $4, $2
; MIPS3-NEXT:    jr $ra
; MIPS3-NEXT:    daddu $2, $2, $1
;
; MIPS64-LABEL: mul128:
; MIPS64:       # %bb.0: # %entry
; MIPS64-NEXT:    dmult $4, $7
; MIPS64-NEXT:    mflo $1
; MIPS64-NEXT:    dmult $5, $6
; MIPS64-NEXT:    mflo $2
; MIPS64-NEXT:    dmultu $5, $7
; MIPS64-NEXT:    mflo $3
; MIPS64-NEXT:    mfhi $4
; MIPS64-NEXT:    daddu $2, $4, $2
; MIPS64-NEXT:    jr $ra
; MIPS64-NEXT:    daddu $2, $2, $1
entry:
  %p = mul i128 %a, %b
  ret i128 %p
}

; The high half of one product feeds the next one: mfhi followed by dmultu.
define i64 @umulh_chain(i64 %a, i64 %b, i64 %d) {
; MIPS3-LABEL: umulh_chain:
; MIPS3:       # %bb.0: # %entry
; MIPS3-NEXT:    dmultu $4, $5
; MIPS3-NEXT:    mfhi $1
; MIPS3-NEXT:    nop
; MIPS3-NEXT:    nop
; MIPS3-NEXT:    dmultu $1, $6
; MIPS3-NEXT:    mfhi $1
; MIPS3-NEXT:    mflo $2
; MIPS3-NEXT:    jr $ra
; MIPS3-NEXT:    xor $2, $2, $1
;
; MIPS64-LABEL: umulh_chain:
; MIPS64:       # %bb.0: # %entry
; MIPS64-NEXT:    dmultu $4, $5
; MIPS64-NEXT:    mfhi $1
; MIPS64-NEXT:    dmultu $1, $6
; MIPS64-NEXT:    mfhi $1
; MIPS64-NEXT:    mflo $2
; MIPS64-NEXT:    jr $ra
; MIPS64-NEXT:    xor $2, $2, $1
entry:
  %aw = zext i64 %a to i128
  %bw = zext i64 %b to i128
  %p = mul i128 %aw, %bw
  %ph = lshr i128 %p, 64
  %h = trunc i128 %ph to i64
  %hw = zext i64 %h to i128
  %dw = zext i64 %d to i128
  %q = mul i128 %hw, %dw
  %ql = trunc i128 %q to i64
  %qh = lshr i128 %q, 64
  %qh64 = trunc i128 %qh to i64
  %r = xor i64 %ql, %qh64
  ret i64 %r
}

; mfhi; mflo; X; mult: the mult is one instruction after the mflo.
define i32 @udivrem_mul(i32 %a, i32 %b, i32 %c) {
; MIPS3-LABEL: udivrem_mul:
; MIPS3:       # %bb.0: # %entry
; MIPS3-NEXT:    sll $1, $5, 0
; MIPS3-NEXT:    sll $2, $4, 0
; MIPS3-NEXT:    divu $zero, $2, $1
; MIPS3-NEXT:    teq $1, $zero, 7
; MIPS3-NEXT:    mfhi $1
; MIPS3-NEXT:    mflo $2
; MIPS3-NEXT:    sll $3, $6, 0
; MIPS3-NEXT:    nop
; MIPS3-NEXT:    mult $2, $3
; MIPS3-NEXT:    mflo $2
; MIPS3-NEXT:    jr $ra
; MIPS3-NEXT:    addu $2, $2, $1
;
; MIPS64-LABEL: udivrem_mul:
; MIPS64:       # %bb.0: # %entry
; MIPS64-NEXT:    sll $1, $5, 0
; MIPS64-NEXT:    sll $2, $4, 0
; MIPS64-NEXT:    divu $zero, $2, $1
; MIPS64-NEXT:    teq $1, $zero, 7
; MIPS64-NEXT:    mfhi $1
; MIPS64-NEXT:    mflo $2
; MIPS64-NEXT:    sll $3, $6, 0
; MIPS64-NEXT:    mul $2, $2, $3
; MIPS64-NEXT:    jr $ra
; MIPS64-NEXT:    addu $2, $2, $1
entry:
  %q = udiv i32 %a, %b
  %r = urem i32 %a, %b
  %m = mul i32 %q, %c
  %s = add i32 %m, %r
  ret i32 %s
}
